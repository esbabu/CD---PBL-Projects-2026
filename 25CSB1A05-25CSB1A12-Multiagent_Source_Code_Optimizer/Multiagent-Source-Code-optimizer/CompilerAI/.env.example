# Backend Configuration
APP_NAME="CompilerAI Run Service"
APP_VERSION="0.2.0"
API_PREFIX="/api"
DEMO_MODE=false

# Real Agent Integrations (auto-discovered from workspace if omitted)
USE_REAL_OPTIMIZATION=true
USE_REAL_SECURITY=true
# ALGO_AGENT_PATH_OVERRIDE="./algo_agent/algo_agent"
# SECURITY_AGENT_PATH_OVERRIDE="./security_related_files (2)/security_related_files"
LLM_CONNECTED=false

# Groq Algo Agent Configuration
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# Ports
BACKEND_PORT=8000
FRONTEND_PORT=5173
